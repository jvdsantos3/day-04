# SQLite database URL
DATABASE_URL=sqlite:///./data/finance.db

# ChromaDB persistent storage path
CHROMA_PATH=./data/chroma

# Secret used to sign JWT session cookies (HS256)
JWT_SECRET=change-me-in-production

# DeepSeek API key (https://api.deepseek.com)
DEEPSEEK_API_KEY=

# HuggingFace cache dir for local embedding model (multilingual-e5-small)
HF_HOME=./data/hf
